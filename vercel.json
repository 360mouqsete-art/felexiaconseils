{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-site",
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/intelligence.js": {
      "maxDuration": 240,
      "includeFiles": "{dist/route-manifest.json,dist/fr/guides/**/*.html,docs/INTELLIGENCE-INVENTAIRE-GUIDES.json,src/intelligence/reserve*.json}"
    },
    "api/intelligence-cron.js": {
      "maxDuration": 240,
      "includeFiles": "{dist/route-manifest.json,docs/INTELLIGENCE-INVENTAIRE-GUIDES.json,src/intelligence/reserve.json}"
    },
    "api/intelligence-public.js": {
      "maxDuration": 30,
      "includeFiles": "dist/{route-manifest.json,{fr,en,ar}/guides/**/*.html}"
    },
    "api/intelligence-sitemap.js": {
      "maxDuration": 30,
      "includeFiles": "dist/sitemap.xml"
    },
    "api/intelligence-media.js": {
      "maxDuration": 30
    }
  },

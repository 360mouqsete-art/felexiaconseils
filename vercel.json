{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-site",
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/dossier.js": {
      "maxDuration": 30
    },
    "api/intelligence.js": {
      "maxDuration": 240,
      "includeFiles": "{dist/route-manifest.json,dist/fr/guides/**/*.html,docs/INTELLIGENCE-INVENTAIRE-GUIDES.json,src/intelligence/reserve*.json}"
    },
    "api/intelligence-cron.js": {
      "maxDuration": 240,
      "includeFiles": "{dist/route-manifest.json,docs/INTELLIGENCE-INVENTAIRE-GUIDES.json,src/intelligence/reserve.json}"
    },
    "api/intelligence-public.js": {
      "maxDuration": 30,
      "includeFiles": "dist/{route-manifest.json,{fr,en,ar}/guides/**/*.html}"
    },
    "api/intelligence-sitemap.js": {
      "maxDuration": 30,
      "includeFiles": "dist/sitemap.xml"
    },
    "api/intelligence-media.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/fr/",
      "statusCode": 308
    },
    {
      "source": "/:locale(fr|en|ar)",
      "destination": "/:locale/",
      "statusCode": 308
    },
    {
      "source": "/:locale(fr|en|ar)/:path((?:[^/]+/)*[^/.]+)",
      "destination": "/:locale/:path/",
      "statusCode": 308
    },
    {
      "source": "/:page(creation-entreprise|domiciliation|guides|contact|rejoignez-nous|mentions-legales|politique-confidentialite|cgu)",
      "destination": "/fr/:page/",
      "statusCode": 308
    },
    {
      "source": "/:page(creation-entreprise|domiciliation|guides|contact|rejoignez-nous|mentions-legales|politique-confidentialite|cgu)/",
      "destination": "/fr/:page/",
      "statusCode": 308
    },
    {
      "source": "/tarif/:plan(creation|domiciliation)",
      "destination": "/fr/tarif/:plan/",
      "statusCode": 308
    },
    {
      "source": "/tarif/:plan(creation|domiciliation)/",
      "destination": "/fr/tarif/:plan/",
      "statusCode": 308
    },
    {
      "source": "/guides/:slug",
      "destination": "/fr/guides/:slug/",
      "statusCode": 308
    },
    {
      "source": "/guides/:slug/",
      "destination": "/fr/guides/:slug/",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/api/contact/",
      "destination": "/api/contact"
    },
    {
      "source": "/api/dossier/",
      "destination": "/api/dossier"
    },
    {
      "source": "/:locale(fr|en|ar)/guides/page/:page/",
      "destination": "/api/intelligence-public?lang=:locale&page=:page"
    },
    {
      "source": "/:locale(fr|en|ar)/guides/theme/:theme/page/:page/",
      "destination": "/api/intelligence-public?lang=:locale&theme=:theme&page=:page"
    },
    {
      "source": "/:locale(fr|en|ar)/guides/theme/:theme/",
      "destination": "/api/intelligence-public?lang=:locale&theme=:theme"
    },
    {
      "source": "/:locale(fr|en|ar)/guides/",
      "destination": "/api/intelligence-public?lang=:locale"
    },
    {
      "source": "/:locale(fr|en|ar)/guides/:slug/",
      "destination": "/api/intelligence-public?lang=:locale&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/intelligence-sitemap"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}

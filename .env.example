# Origine publique canonique ; reconstruire apres une modification.
SITE_URL=https://www.felexiaconseils.com
PORT=4173
NODE_ENV=production

# Option A : envoi Resend. Utiliser une adresse d'expedition sur un domaine verifie.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hadigui.aziz@gmail.com

# Option B : endpoint HTTPS du CRM / service de traitement du cabinet.
# Cette option est prioritaire sur Resend. Le endpoint doit persister la demande
# avant de repondre 2xx et dedupliquer avec l'en-tete Idempotency-Key.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Activer uniquement derriere un proxy de confiance qui reecrit X-Forwarded-For.
TRUST_PROXY=0
# Requested project: https://yxdmkqdnesemaqzagatm.supabase.co
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative for projects still using a legacy service-role JWT:
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit HTTPS origins, comma-separated. Never use a wildcard.
CONTACT_ALLOWED_ORIGINS=
